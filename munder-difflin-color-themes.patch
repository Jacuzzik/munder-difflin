+  --cth-sim-filter: brightness(0.92) sepia(0.12) saturate(1.05);
+}
+
+/* ── Violet — deep violet ground, magenta accent ────────────────────────── */
+:root[data-cth-palette='violet'] {
+  --cth-cream-50:  #0E0B12;
+  --cth-cream-100: #14101A;
+  --cth-cream-200: #1D1825;
+  --cth-cream-300: #2A2233;
+  --cth-paper-100: #110E16;
+  --cth-paper-200: #19141F;
+
+  --cth-ink-900: #EDE7F3;
+  --cth-ink-700: #BDB2CA;
+  --cth-ink-500: #968BA5;
+  --cth-ink-300: #716682;
+  --cth-ink-100: #2D2538;
+
+  --cth-lemon: #D05FE0;   --cth-lemon-light: #34193B;
+  --cth-lilac: #B48AF2;   --cth-lilac-light: #2A2140;
+
+  --cth-glass-bg:     rgba(26, 20, 34, 0.72);
+  --cth-glass-border: rgba(208, 95, 224, 0.10);
+  --cth-titlebar-bg:  rgba(14, 11, 18, 0.78);
+  --cth-accent:      #D05FE0;
+  --cth-accent-fg:   #16081A;
+  --cth-accent-soft: rgba(208, 95, 224, 0.13);
+  --cth-focus-ring:  0 0 0 3px rgba(208, 95, 224, 0.35);
+  --cth-selection:   rgba(180, 138, 242, 0.26);
+
+  --cth-sim-filter: brightness(0.94) saturate(0.96);
+}
+
+/* Accessibility: frostier surfaces and firmer edges when asked. */
+@media (prefers-reduced-transparency: reduce) {
+  /* [data-cth-palette] matches the palette blocks' specificity; source order wins. */
+  :root[data-cth-palette] {
+    --cth-glass-bg: var(--cth-cream-100);
+    --cth-titlebar-bg: var(--cth-cream-100);
+    --cth-glass-blur: none;
+  }
+}
+@media (prefers-contrast: more) {
+  :root[data-cth-palette] {
+    --cth-glass-bg: var(--cth-cream-100);
+    --cth-titlebar-bg: var(--cth-cream-100);
+    --cth-glass-blur: none;
+    --cth-glass-border: var(--cth-ink-500);
+  }
+}
