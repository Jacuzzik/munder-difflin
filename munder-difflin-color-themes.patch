+.cth-topbar-btn {
+  display: inline-flex; align-items: center; justify-content: center;
+  height: 28px; min-width: 28px; padding: 0 6px;
+  background: transparent; border: none; border-radius: var(--cth-radius-sm);
+  color: var(--cth-ink-700); cursor: pointer; gap: 6px;
+  font-family: var(--cth-font-ui); font-size: 12.5px; font-weight: 500;
+}
+.cth-topbar-btn:hover { background: var(--cth-hover); color: var(--cth-ink-900); }
+.cth-topbar-btn:active { background: var(--cth-pressed); transform: scale(0.96); }
+.cth-topbar-btn[aria-expanded="true"] { background: var(--cth-pressed); color: var(--cth-ink-900); }
+.cth-topbar-sep { width: 1px; height: 16px; background: var(--cth-ink-100); flex-shrink: 0; }
+.cth-status-pill {
