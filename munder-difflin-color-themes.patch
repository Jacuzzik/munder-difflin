+.cth-theme-option {
+  width: 100%; display: flex; align-items: center; gap: 10px;
+  padding: 7px 10px; border: none; background: transparent; cursor: pointer;
+  border-radius: var(--cth-radius-md); text-align: start; color: var(--cth-ink-900);
+  font-family: var(--cth-font-ui);
+}
+.cth-theme-option:hover { background: var(--cth-hover); }
+.cth-theme-option:active { background: var(--cth-pressed); }
+.cth-theme-option[aria-checked="true"] { background: var(--cth-accent-soft); }
+.cth-theme-option-name { font-size: 13px; font-weight: 500; line-height: 17px; }
+.cth-theme-option-blurb { font-size: 11.5px; line-height: 15px; color: var(--cth-ink-500); }
+.cth-swatch {
+  position: relative; flex-shrink: 0; width: 34px; height: 24px; border-radius: 6px; overflow: hidden;
+  box-shadow: 0 0 0 0.5px rgba(0,0,0,0.18), inset 0 0 0 0.5px rgba(255,255,255,0.10);
+}
+.cth-swatch > i { position: absolute; display: block; }
+.cth-swatch-sm { width: 18px; height: 12px; border-radius: 3.5px; }
+
+/* ── Workspace shell ────────────────────────────────────────────────────── */
+.cth-workspace { background: var(--cth-cream-50); }
+.cth-sidebar-panel {
+  border-radius: var(--cth-radius-lg);
+  overflow: hidden;
+  box-shadow: var(--cth-shadow-md);
+}
+
+/* ── Tabs ─────────────────────────────────────────────────────────────────
+   Two families, both keyed off aria-selected so state and styling can never
+   disagree. `--tab-accent` is the owning agent's accent (identity), set inline. */
+.cth-seg-tab {
+  background: transparent;
+  color: var(--cth-ink-700);
+  box-shadow: none;
+}
+.cth-seg-tab:hover { background: var(--cth-hover); color: var(--cth-ink-900); }
+.cth-seg-tab:active { background: var(--cth-pressed); }
+.cth-seg-tab[aria-selected="true"] {
+  background: color-mix(in srgb, var(--tab-accent) 20%, var(--cth-cream-100));
+  color: var(--cth-ink-900);
+  font-weight: 600;
+  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tab-accent) 55%, transparent);
+}
+.cth-underline-tab {
+  position: relative;
+  background: transparent;
+  color: var(--cth-ink-500);
+  border-radius: 0;
+}
+.cth-underline-tab:hover { color: var(--cth-ink-900); background: var(--cth-hover); }
+.cth-underline-tab[aria-selected="true"] { color: var(--cth-ink-900); }
+.cth-underline-tab::after {
+  content: ""; position: absolute; left: 10px; right: 10px; bottom: 0; height: 2px;
+  border-radius: 2px 2px 0 0; background: var(--tab-accent);
+  transform: scaleX(0); transition: transform var(--cth-dur-med) var(--cth-ease-out);
+}
+.cth-underline-tab[aria-selected="true"]::after { transform: scaleX(1); }
+
+/* ── Modal scrims ─────────────────────────────────────────────────────────
+   Dim-to-focus: every modal scrim reads --cth-scrim (lighter in light
+   palettes, deeper in dark ones) and fades in rather than snapping. The sheet
+   inside is PixelPanel's `dialog` variant, which now carries --cth-shadow-lg. */
+@keyframes cth-fade-in { from { opacity: 0; } to { opacity: 1; } }
+
+/* Native controls follow the palette's chrome accent (radios, checkboxes,
+   sliders, progress) instead of Chromium's default blue. */
+input[type="radio"], input[type="checkbox"], input[type="range"], progress { accent-color: var(--cth-accent); }
+
+/* Inline status chips ("BOSS", "INSTALLED", "RECOMMENDED", …): ~dozens of call
+   sites build them as a display-font span with a 1px inset hairline. Round
+   their corners slightly so they match every other v0.5 surface. Radius only —
+   size, colour and layout are untouched. */
+span[style*="--cth-font-display"][style*="inset 0 0 0 1px"] { border-radius: var(--cth-radius-xs); }
