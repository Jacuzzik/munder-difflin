+  position: absolute; top: calc(100% + 8px); right: 0; z-index: 400;
+  width: 272px; padding: 6px;
+  background: var(--cth-glass-bg);
+  -webkit-backdrop-filter: var(--cth-glass-blur);
+  backdrop-filter: var(--cth-glass-blur);
+  border-radius: var(--cth-radius-lg);
