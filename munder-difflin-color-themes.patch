+/* ════════════════════════════════════════════════════════════════════════════
+   v0.5 — Apple-inspired chrome
+   ════════════════════════════════════════════════════════════════════════════ */
+
+/* Display-slot labels. ~110 call sites set `fontFamily: var(--cth-font-display)`
+   at 8–12px, sized for the wide pixel face. Now that the token is the UI stack,
+   they become section headers: semibold, lightly tracked (small text wants
+   positive tracking), and font-size-adjust scales the x-height so an 8px slot
+   renders like ~10–11px Inter. Presentation only: no call site changes, and
+   swapping the token back restores the old look wholesale. */
+[style*="--cth-font-display"] {
+  font-weight: 600;
+  letter-spacing: 0.045em;
+  font-size-adjust: 0.7;
+}
+/* These three properties inherit, so a display-slot container would otherwise
+   push its weight/tracking/size-adjust into body text nested inside it. Any
+   descendant that declares its own UI or mono face opts back out. */
+[style*="--cth-font-display"] [style*="--cth-font-ui"],
+[style*="--cth-font-display"] [style*="--cth-font-mono"] {
+  font-weight: 400;
+  letter-spacing: normal;
+  font-size-adjust: none;
+}
+
+/* Brand-only pixel face, kept for the one place identity should stay retro. */
+.cth-brand { font-family: var(--cth-font-brand); }
+
+/* Buttons: moderate radius + responsive press. Inline border-radius (a handful
+   of flush controls) still wins, so nothing that was deliberately square moves.
+   Feedback lives on the press (Apple: respond on pointer-down). */
+button {
+  border-radius: var(--cth-radius-sm);
+  transition:
+    background-color var(--cth-dur-fast) var(--cth-ease),
+    color var(--cth-dur-fast) var(--cth-ease),
+    box-shadow var(--cth-dur-fast) var(--cth-ease),
+    transform var(--cth-dur-fast) var(--cth-ease-out);
+}
+select, input[type="text"], input[type="number"], input[type="search"],
+input[type="password"], input[type="url"], input[type="email"], textarea {
+  border-radius: var(--cth-radius-sm);
+}
+
+/* ── The simulator surface ────────────────────────────────────────────────
+   Non-destructive theme treatment: a CSS filter on the Pixi <canvas> ELEMENT.
+   It runs in the compositor on the finished frame — textures, scene graph,
+   camera and hit-testing are untouched (filters never change pointer
+   targeting), and `none` composites the canvas exactly as before. Scoped to
+   the direct canvas so DOM overlays on the floor (memory panel, empty-state
+   dialog, error note) are never filtered. */
+.cth-sim-surface { width: 100%; height: 100%; border-radius: var(--cth-radius-lg); overflow: hidden; box-shadow: var(--cth-shadow-md); }
+.cth-sim-surface canvas {
+  filter: var(--cth-sim-filter);
+  transition: filter 280ms var(--cth-ease);
+}
+
+/* ── Top bar ────────────────────────────────────────────────────────────── */
+.cth-topbar {
+  position: relative;
+  /* Above floor overlays (MemoryPanel is 40) so the picker menu can hang over
+     the floor; below focus mode (250) and every modal, which still cover it. */
+  z-index: 45;
+  background: var(--cth-titlebar-bg);
+  -webkit-backdrop-filter: var(--cth-glass-blur);
+  backdrop-filter: var(--cth-glass-blur);
+  box-shadow: inset 0 -0.5px 0 var(--cth-glass-border), inset 0 -1px 0 var(--cth-ink-100);
