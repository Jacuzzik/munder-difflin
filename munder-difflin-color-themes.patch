@@ -0,0 +1,34 @@
+/**
+ * The one place a palette change fans out beyond CSS. Both theme entry points
+ * (the top-bar picker and focus mode's quick toggle) go through here so a TUI
+ * running in a background terminal is never left on the old mode.
+ *
+ * Only a BASE MODE change is forwarded: moving Obsidian → Ember changes chrome
+ * and the xterm palette (PtyTerminalView follows useAppPalette), but a running
+ * program only understands light/dark, so it is told nothing it does not need.
+ */
+import { appTheme, setAppPalette, toggleAppTheme, type AppPalette, type AppTheme } from './theme';
+import { notifyThemeChangeAll } from '@/components/terminalPool';
+
+function forwardMode(prev: AppTheme, next: AppTheme): void {
+  if (prev === next) return;
+  // Tell every RUNNING program the mode flipped (DEC mode 2031 subscribers).
+  notifyThemeChangeAll(next);
+  // Every agent (re)spawned from now on gets the matching Claude session
+  // theme. Scoped to harness agents; the user's global Claude theme is never
+  // touched. Existing IPC, existing config key.
+  void window.cth.updateConfig({ terminalTheme: next });
+}
+
+export function selectPalette(id: AppPalette): void {
+  const prev = appTheme();
+  const next = setAppPalette(id);
+  forwardMode(prev, next);
+}
+
+export function toggleModeEverywhere(): AppTheme {
+  const prev = appTheme();
+  const next = toggleAppTheme();
+  forwardMode(prev, next);
+  return next;
+}
